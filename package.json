{
  "name": "vibe-blueprint",
  "version": "0.1.0",
  "description": "Reads a codebase, derives its actual architecture, and measures it against the architecture that was claimed.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vibe-blueprint": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc && npm run build:ui && node scripts/copy-static.mjs",
    "build:server": "tsc",
    "build:ui": "npm --prefix ui run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@hono/node-server": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "hono": "^4.13.1",
    "ignore": "^7.0.6",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  },
  "license": "MIT",
  "private": true,
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.21.5": true
  }
}
