    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Workspace", "url": "/workspace.html", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Analysis", "url": "/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
